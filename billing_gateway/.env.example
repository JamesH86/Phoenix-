# Use "sandbox" until the complete test purchase, webhook, and claim flow passes.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_API_VERSION=2026-07-15

# Must exactly match the URL registered on the Square webhook subscription.
SQUARE_WEBHOOK_NOTIFICATION_URL=https://your-billing-domain.example/api/square-webhook
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Generate both values with: npm run generate:keys
PHOENIX_PURCHASE_RECEIPT_SECRET_B64=
PHOENIX_LICENSE_ED25519_PRIVATE_KEY_B64=
PHOENIX_LICENSE_KEY_ID=

PHOENIX_LICENSE_ISSUER=https://your-billing-domain.example
PHOENIX_ALLOWED_ORIGINS=https://your-app.example,http://127.0.0.1:8787
PHOENIX_DEFAULT_RETURN_URL=https://your-app.example/plans
